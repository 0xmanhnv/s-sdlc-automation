# ===========================================
# n8n Environment Configuration Template
# ===========================================
# Copy this file to .env and update values
# Usage: cp env.template .env

# ===========================================
# ENVIRONMENT TYPE - CHOOSE ONE
# ===========================================
# Development: docker-compose up -d
# Production:  docker-compose up -d (with production .env settings)

# ===========================================
# VERSION & BASIC SETTINGS
# ===========================================
N8N_VERSION=1.104.0

# ===========================================
# SECURITY SETTINGS - CHANGE THESE!
# ===========================================
# Generate: openssl rand -base64 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_REQUIRED

# Database password (required for both dev/prod)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis password (production only)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Development defaults (can override)
POSTGRES_USER=n8n_dev
POSTGRES_DB=n8n_dev
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Development (local)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# ===========================================
# TIMEZONE CONFIGURATION
# ===========================================
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# ===========================================
# USER MANAGEMENT (Production Recommended)
# ===========================================
# Enable user management
N8N_USER_MANAGEMENT_DISABLED=false

# Owner account (first admin user)
N8N_OWNER_EMAIL=admin@yourcompany.com
N8N_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# User settings
N8N_SIGNUP_ALLOWED=false
N8N_USER_PASSWORD_MIN_LENGTH=8
N8N_USER_PASSWORD_COMPLEXITY=true

# ===========================================
# BASIC AUTH (Development Only)
# ===========================================
# Use for dev environment only
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_BASIC_AUTH

# ===========================================
# EMAIL CONFIGURATION (Production)
# ===========================================
# Required for user invitations in production
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-password
N8N_SMTP_SENDER=n8n@yourcompany.com
N8N_SMTP_SSL=true

# ===========================================
# SSL CONFIGURATION (Production Only)
# ===========================================
# For Let's Encrypt certificate
SSL_EMAIL=admin@yourcompany.com

# ===========================================
# SAML SSO INTEGRATION (Optional - Production)
# ===========================================
# Microsoft Entra ID / Azure AD Integration
N8N_SAML_ENABLED=false
# N8N_SAML_ENTITY_ID=https://n8n.yourcompany.com/n8n
# N8N_SAML_ASSERT_URL=https://n8n.yourcompany.com/rest/sso/saml/acs
# N8N_SAML_METADATA_URL=https://login.microsoftonline.com/{tenant-id}/federationmetadata/2007-06/federationmetadata.xml

# SAML Attribute Mapping
# N8N_SAML_EMAIL_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
# N8N_SAML_FIRST_NAME_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname
# N8N_SAML_LAST_NAME_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname

# SAML Security Settings
# N8N_SAML_SIGNED_RESPONSE=true
# N8N_SAML_SIGNED_ASSERTION=true
# N8N_SAML_LOGIN_ENABLED=true
# N8N_SAML_LOGIN_LABEL=Sign in with Microsoft

# SAML Role Mapping (Optional)
# N8N_SAML_ROLE_MAPPING_ENABLED=false
# N8N_SAML_ROLE_OWNER_GROUPS=n8n-owners
# N8N_SAML_ROLE_ADMIN_GROUPS=n8n-admins
# N8N_SAML_ROLE_MEMBER_GROUPS=n8n-users

# ===========================================
# QUEUE CONFIGURATION (DevSecOps High-Load Processing)
# ===========================================
# Enable queue mode for parallel processing and scaling
# Essential for DevSecOps workflows handling multiple SAST scans
QUEUE_MODE=true
EXECUTIONS_MODE=queue

# Queue processing settings
N8N_QUEUE_HEALTH_CHECK_ACTIVE=true
N8N_QUEUE_HEALTH_CHECK_PORT=5678

# Worker configuration (used when running worker instances)
# QUEUE_WORKER_TIMEOUT=60
# N8N_QUEUE_RECOVERY_INTERVAL=60

# ===========================================
# PERFORMANCE & MONITORING
# ===========================================
# Metrics and monitoring
N8N_METRICS=true

# Execution data management
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Binary data settings
N8N_BINARY_DATA_TTL=1440

# Logging
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# ===========================================
# WORKFLOW SETTINGS
# ===========================================
WORKFLOWS_DEFAULT_NAME=My workflow
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ===========================================
# NEW n8n 1.104.0+ CONFIGURATION
# ===========================================
# Task runners (recommended for scaling)
N8N_RUNNERS_ENABLED=true

# Manual execution handling
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

# File permissions security
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Worker timeout (replaces QUEUE_WORKER_TIMEOUT)
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=60

# ===========================================
# ENVIRONMENT OVERRIDES
# ===========================================
# Uncomment and modify the appropriate section for your environment

# ===========================================
# DEVELOPMENT OVERRIDES
# ===========================================
# Uncomment for development environment

# Development database settings
# POSTGRES_USER=n8n_dev
# POSTGRES_DB=n8n_dev
# POSTGRES_PASSWORD=n8n_dev_pass

# Development server settings  
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_PROTOCOL=http
# WEBHOOK_URL=http://localhost:5678

# Development features
# N8N_USER_MANAGEMENT_DISABLED=true
# N8N_BASIC_AUTH_ACTIVE=false
# N8N_LOG_LEVEL=debug

# ===========================================
# PRODUCTION OVERRIDES  
# ===========================================
# Uncomment for production environment

# Production database settings
# POSTGRES_USER=n8n_prod
# POSTGRES_DB=n8n_prod
# POSTGRES_PASSWORD=your-strong-prod-password

# Production server settings
# N8N_HOST=n8n.yourcompany.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.yourcompany.com

# Production security
# N8N_USER_MANAGEMENT_DISABLED=false
# N8N_BASIC_AUTH_ACTIVE=false 