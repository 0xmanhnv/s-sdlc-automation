# ===========================================
# VERSION & BASIC SETTINGS
# ===========================================
N8N_VERSION=1.104.0

# ===========================================
# SECURITY SETTINGS - CHANGE THESE!
# ===========================================
# Generate via: openssl rand -base64 32
N8N_ENCRYPTION_KEY=Thay_bang_32_ky_tu_ngau_nhien
N8N_SECURE_COOKIE=false

# Database
POSTGRES_PASSWORD=CucManh_DB_Pass

# Redis (dùng nếu bật queue)
REDIS_PASSWORD=CucManh_Redis_Pass

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=n8n_prod
POSTGRES_DB=n8n_prod
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Domain của bạn (khớp với DNS + proxy)
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http

# URL thật sẽ được public
WEBHOOK_URL=https://localhost
DOMAIN_NAME=localhost

# ===========================================
# TIMEZONE
# ===========================================
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# ===========================================
# USER MANAGEMENT
# ===========================================
N8N_USER_MANAGEMENT_DISABLED=false
N8N_OWNER_EMAIL=admin@appsec.ipas.com.vn
N8N_OWNER_PASSWORD=BanMatCucManh123!

N8N_SIGNUP_ALLOWED=false
N8N_USER_PASSWORD_MIN_LENGTH=8
N8N_USER_PASSWORD_COMPLEXITY=true

# ===========================================
# BASIC AUTH (Dùng cho dev, tắt trên prod)
# ===========================================
N8N_BASIC_AUTH_ACTIVE=false

# ===========================================
# EMAIL CONFIGURATION (Gửi invite người dùng)
# ===========================================
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-password
N8N_SMTP_SENDER=n8n@appsec.ipas.com.vn
N8N_SMTP_SSL=true

# ===========================================
# QUEUE CONFIGURATION
# ===========================================
QUEUE_MODE=true
EXECUTIONS_MODE=queue
N8N_QUEUE_HEALTH_CHECK_ACTIVE=true
N8N_QUEUE_HEALTH_CHECK_PORT=5678

# ===========================================
# PERFORMANCE & MONITORING
# ===========================================
N8N_METRICS=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# ===========================================
# STORAGE & LOGGING
# ===========================================
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_BINARY_DATA_TTL=1440

# ===========================================
# NEW: Worker task runner mode (1.104+)
# ===========================================
N8N_RUNNERS_ENABLED=true
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=60
