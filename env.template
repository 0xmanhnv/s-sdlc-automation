# ===========================================
# N8N PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and update the values
# NEVER commit .env file to version control!

# ===========================================
# N8N Core Configuration
# ===========================================
N8N_VERSION=1.104.0
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# ===========================================
# SSL/NGINX CONFIGURATION
# ===========================================
# SSL certificate email (for Let's Encrypt)
SSL_EMAIL=admin@yourcompany.com

# ===========================================
# SECURITY SETTINGS - CHANGE THESE!
# ===========================================
# Generate a strong 32+ character encryption key
# Use: openssl rand -base64 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_REQUIRED

# Basic Auth (for development only)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_TYPE=postgresdb
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===========================================
# TIMEZONE SETTINGS
# ===========================================
# Set to your local timezone
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# ===========================================
# PERFORMANCE & MONITORING
# ===========================================
N8N_METRICS=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# ===========================================
# WEBHOOK CONFIGURATION
# ===========================================
# For production, set to your actual domain
WEBHOOK_URL=http://localhost:5678

# ===========================================
# WORKFLOW SETTINGS
# ===========================================
WORKFLOWS_DEFAULT_NAME=My workflow

# ===========================================
# USER MANAGEMENT CONFIGURATION
# ===========================================
# Enable user management (disable for single-user setup)
N8N_USER_MANAGEMENT_DISABLED=false

# Owner account setup (first user)
N8N_OWNER_EMAIL=admin@yourcompany.com
N8N_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# User registration settings
N8N_SIGNUP_ALLOWED=false  # true = open registration, false = invite only

# Password policy
N8N_USER_PASSWORD_MIN_LENGTH=8
N8N_USER_PASSWORD_COMPLEXITY=true

# Session management
N8N_USER_SESSION_TIMEOUT=86400  # 24 hours

# Invitation settings
N8N_USER_INVITATION_EXPIRY_TIME=7  # days

# ===========================================
# EMAIL CONFIGURATION (for user invitations)
# ===========================================
# Email mode: smtp or sendmail
N8N_EMAIL_MODE=smtp

# SMTP Settings (Gmail example)
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
N8N_SMTP_SENDER=noreply@yourcompany.com
N8N_SMTP_SSL=false
N8N_SMTP_TLS=true

# ===========================================
# LDAP INTEGRATION (Optional)
# ===========================================
# N8N_LDAP_ENABLED=true
# N8N_LDAP_SERVER=ldap://your-ldap-server.com
# N8N_LDAP_PORT=389
# N8N_LDAP_BIND_DN=cn=admin,dc=company,dc=com
# N8N_LDAP_BIND_CREDENTIALS=LDAP_ADMIN_PASSWORD
# N8N_LDAP_BASE_DN=dc=company,dc=com
# N8N_LDAP_LOGIN_ID_ATTRIBUTE=uid
# N8N_LDAP_EMAIL_ATTRIBUTE=mail
# N8N_LDAP_FIRST_NAME_ATTRIBUTE=givenName
# N8N_LDAP_LAST_NAME_ATTRIBUTE=sn

# ===========================================
# SAML SSO INTEGRATION (Optional)
# ===========================================
# Enable SAML SSO (for enterprise authentication)
# N8N_SAML_ENABLED=true

# Entity Configuration
# N8N_SAML_ENTITY_ID=https://your-domain.com/n8n
# N8N_SAML_ASSERT_URL=https://your-domain.com/rest/sso/saml/acs

# Metadata Configuration (choose one)
# N8N_SAML_METADATA_URL=https://login.microsoftonline.com/{tenant-id}/federationmetadata/2007-06/federationmetadata.xml
# N8N_SAML_METADATA_FILE=/home/node/.n8n/saml-metadata.xml

# User Attribute Mapping (Microsoft Entra ID)
# N8N_SAML_EMAIL_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
# N8N_SAML_FIRST_NAME_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname
# N8N_SAML_LAST_NAME_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname

# Security Settings
# N8N_SAML_SIGNED_RESPONSE=true
# N8N_SAML_SIGNED_ASSERTION=true
# N8N_SAML_LOGIN_ENABLED=true
# N8N_SAML_LOGIN_LABEL=Sign in with Microsoft

# Role Mapping (Optional - map Azure AD groups to n8n roles)
# N8N_SAML_ROLE_MAPPING_ENABLED=true
# N8N_SAML_USER_ROLE_ATTRIBUTE=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups
# N8N_SAML_ROLE_OWNER_GROUPS=n8n-owners
# N8N_SAML_ROLE_ADMIN_GROUPS=n8n-admins,n8n-owners
# N8N_SAML_ROLE_MEMBER_GROUPS=n8n-members,n8n-admins,n8n-owners
# N8N_SAML_ROLE_GUEST_GROUPS=n8n-guests
# N8N_SAML_DEFAULT_ROLE=member

# ===========================================
# PROJECT MANAGEMENT (Enterprise)
# ===========================================
# N8N_PROJECTS_ENABLED=true
# N8N_PROJECT_DEFAULT_NAME=Default Project 