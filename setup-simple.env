# ===========================================
# n8n Simple Configuration
# ===========================================
# Copy to .env and update passwords

# Version
N8N_VERSION=1.104.0

# Domain & Protocol  
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# Security (CHANGE THESE!)
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-here
POSTGRES_PASSWORD=your-strong-db-password

# Database
POSTGRES_DB=n8n
POSTGRES_USER=n8n

# Optional: SSL (set for production with domain)
# N8N_HOST=n8n.yourcompany.com  
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.yourcompany.com 